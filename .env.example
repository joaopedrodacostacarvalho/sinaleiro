# --- Ambiente Geral ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
DB_HOST=db
DB_PORT=5432
DB_USER=sinaleiro
DB_PASSWORD=troque_esta_senha_em_producao
DB_NAME=sinaleiro_db

# --- TypeORM (em produção: synchronize=false e migrationsRun=true obrigatórios) ---
TYPEORM_SYNCHRONIZE=false
TYPEORM_MIGRATIONS_RUN=true

# --- Segurança, CORS e Rate Limiting ---
# Em produção, informe origens separadas por vírgula sem barra final
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENABLE_SWAGGER=false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# --- Firebase Admin SDK (obrigatórios em produção) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Web (Firebase client SDK) ---
VITE_API_URL=http://localhost:3000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
