# ==============================================================================
# Sinaleiro (Metrorec Colaborativo) — Template de Variáveis de Produção
# Copie para `.env.production` na raiz do repositório antes do deploy.
# NUNCA versione o arquivo `.env.production` real no Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ambiente e Portas Publicadas no Host (docker-compose.prod.yml)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
API_PORT=3000
WEB_PORT=80

# ------------------------------------------------------------------------------
# 2. Banco de Dados PostgreSQL 17
# ------------------------------------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_USER=sinaleiro
DB_PASSWORD=troque-por-uma-senha-forte-e-aleatoria
DB_NAME=sinaleiro

# Controle de schema (validarAmbienteProducao bloqueia TYPEORM_SYNCHRONIZE=true)
TYPEORM_SYNCHRONIZE=false
TYPEORM_MIGRATIONS_RUN=true

# ------------------------------------------------------------------------------
# 3. Segurança HTTP, CORS, Rate Limiting e Documentação (NestJS)
# ------------------------------------------------------------------------------
# Lista separada por vírgula com as origens oficiais permitidas (wildcard "*" é bloqueado)
CORS_ORIGINS=https://sinaleiro.app,https://www.sinaleiro.app

# Limites do ThrottlerGuard (janela curta de 1s e janela padrão de 60s)
THROTTLE_SHORT_LIMIT=10
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# Mantém o Swagger (/api/docs) desabilitado em produção por padrão
ENABLE_SWAGGER=false

# ------------------------------------------------------------------------------
# 4. Firebase Admin SDK (Backend — Validação de ID Tokens)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=seu-projeto-firebase-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto-firebase-prod.iam.gserviceaccount.com
# Mantenha as quebras de linha escapadas (\n) entre aspas duplas
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCOLE_AQUI_A_CHAVE_PRIVADA_DO_SERVICE_ACCOUNT\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 5. Frontend SPA (@sinaleiro/web — Injetado em tempo de build via secret web_env)
# ------------------------------------------------------------------------------
VITE_API_URL=https://api.sinaleiro.app/v1
VITE_FIREBASE_API_KEY=sua-web-api-key-firebase
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto-firebase-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-firebase-prod
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto-firebase-prod.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
